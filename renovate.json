{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests"],
  "enabledManagers": ["docker-compose"],
  "ignorePaths": ["nodes/cd/costaebella/**"],
  "packageRules": [
    {
      "description": "Own images: built by their repos' CI, updated with `home stack update`",
      "matchPackageNames": ["ghcr.io/ashishbhatiya18/**"],
      "enabled": false
    },
    {
      "description": "Immich's Postgres image follows Immich's release notes, not semver",
      "matchPackageNames": ["ghcr.io/immich-app/postgres"],
      "enabled": false
    },
    {
      "description": "Server and machine learning must run the same Immich version",
      "matchPackageNames": ["ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning"],
      "groupName": "immich"
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/code-server", "lscr.io/linuxserver/syncthing"],
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-ls(?<build>\\d+)$"
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/jellyfin"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.?(?<patch>\\d+)?ubu\\d+-ls(?<build>\\d+)$"
    }
  ]
}
